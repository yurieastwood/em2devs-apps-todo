<Project>
  <Target Name="SetupGitHooks" BeforeTargets="Restore" Condition="Exists('$(MSBuildThisFileDirectory).git')">
    <Exec Command="git config core.hooksPath 2>/dev/null | grep -qx 'scripts/hooks' || git config core.hooksPath scripts/hooks" WorkingDirectory="$(MSBuildThisFileDirectory)" />
  </Target>
</Project>
