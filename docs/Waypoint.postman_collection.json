          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/demo-login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const auth = pm.response.json();",
                  "pm.test('Has userId', () => pm.expect(auth.userId).to.be.a('string'));",
                  "pm.test('Has displayName', () => pm.expect(auth.displayName).to.be.a('string'));"
                ]
