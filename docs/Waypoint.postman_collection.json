    {
      "key": "baseUrl",
      "value": "http://localhost:5001",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string"
    },
    {
      "key": "taskId2",
      "value": "",
      "type": "string"
    },
    {
      "key": "questId",
      "value": "",
      "type": "string"
    },
    {
      "key": "epicId",
      "value": "",
      "type": "string"
    }
  ],
